# Copie para .env.local e preencha. NUNCA faça commit de .env.local.
# Em produção, estes valores ficam nas variáveis de ambiente da hospedagem (Vercel).

# Banco (Supabase → Connect → "Transaction pooler", porta 6543). Somente servidor.
DATABASE_URL=

# Endereço público do site
APP_URL=http://localhost:3000

# Supabase Auth (Fase 3 — login do cliente e da equipe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # somente servidor

# Criptografia de campos (CPF, IMEI, EID, ICCID) — 32 bytes em base64
# gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=
# Chave do HMAC usado para buscar CPF sem descriptografar — 32 bytes em base64
CPF_HASH_KEY=

# Asaas (sandbox: https://api-sandbox.asaas.com/v3 · produção: https://api.asaas.com/v3)
# Desenvolvimento local sem chave: npm run dev:asaas-mock e use http://127.0.0.1:4010/v3
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=                  # 32–255 caracteres, sem espaços

# D4Sign (produção: https://secure.d4sign.com.br/api/v1)
D4SIGN_API_URL=https://secure.d4sign.com.br/api/v1
D4SIGN_TOKEN_API=
D4SIGN_CRYPT_KEY=
D4SIGN_SAFE_UUID=                     # cofre onde os contratos serão criados

# E-mail transacional
EMAIL_FROM="Gigachip <contato@seudominio.com.br>"
RESEND_API_KEY=

# Rotas de rotina (pg_cron → /api/cron/*)
CRON_SECRET=

# Atendimento
NEXT_PUBLIC_WHATSAPP_NUMBER=          # só dígitos, ex.: 5588999999999 (vazio = botão escondido)
