# Copie para .env.local e preencha. NUNCA faça commit de .env.local.
# Em produção, estes valores ficam nas variáveis de ambiente da hospedagem (Vercel).

# Banco (Supabase → Connect → "Transaction pooler", porta 6543). Somente servidor.
DATABASE_URL=

# Endereço público do site
APP_URL=http://localhost:3000

# Supabase Auth (Fase 3 — login do cliente e da equipe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # somente servidor

# Criptografia de campos (CPF, IMEI, EID, ICCID) — senha forte com 32+ caracteres (ou 32 bytes em base64)
# gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=
# Chave do HMAC usado para buscar CPF sem descriptografar — senha forte com 32+ caracteres
CPF_HASH_KEY=

# Asaas (sandbox: https://api-sandbox.asaas.com/v3 · produção: https://api.asaas.com/v3)
# Desenvolvimento local sem chave: npm run dev:asaas-mock e use http://127.0.0.1:4010/v3
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=                  # 32–255 caracteres, sem espaços

# D4Sign (contratos). Sem as chaves, o envio de contratos fica desligado.
D4SIGN_API_URL=https://secure.d4sign.com.br/api/v1
D4SIGN_TOKEN_API=
D4SIGN_CRYPT_KEY=
D4SIGN_SAFE_UUID=                     # código do cofre (painel → Integrações → Listar meus cofres)
D4SIGN_WEBHOOK_SECRET=                # senha forte, só letras/números, 32+ caracteres
D4SIGN_RATE_LIMIT_PER_HOUR=10
# Desenvolvimento local: npm run dev:d4sign-mock e use http://127.0.0.1:4020/api/v1

# E-mail transacional
EMAIL_FROM="Gigachip <contato@seudominio.com.br>"
RESEND_API_KEY=

# Rotina diária (Vercel Cron envia "Authorization: Bearer CRON_SECRET"). Senha forte.
CRON_SECRET=

# Painel: código para criar o 1º acesso (dono) em /painel/configurar. Pode remover depois.
ADMIN_SETUP_TOKEN=

# Atendimento
NEXT_PUBLIC_WHATSAPP_NUMBER=          # só dígitos, ex.: 5588999999999 (vazio = botão escondido)
